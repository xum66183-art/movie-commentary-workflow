{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/movie-commentary-workflow/visual-edit.schema.json",
  "title": "Visual edit plan",
  "type": "object",
  "required": ["schema_version", "film_id", "duration_ms", "source", "narration", "clips"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "film_id": {"type": "string", "minLength": 3},
    "duration_ms": {"type": "integer", "minimum": 1000},
    "source": {"type": "string", "minLength": 1},
    "narration": {"type": "string", "minLength": 1},
    "timestamps": {"type": "string", "minLength": 1},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "timeline_start_ms",
          "timeline_end_ms",
          "source_start_ms",
          "source_end_ms",
          "pace",
          "purpose"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "timeline_start_ms": {"type": "integer", "minimum": 0},
          "timeline_end_ms": {"type": "integer", "minimum": 1},
          "source_start_ms": {"type": "integer", "minimum": 0},
          "source_end_ms": {"type": "integer", "minimum": 1},
          "pace": {"enum": ["normal", "suspense", "climax"]},
          "purpose": {"type": "string", "minLength": 1},
          "source_audio": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
